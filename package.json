{
    "name": "llmrun",
    "version": "1.0.5",
    "description": "Run open-source LLMs on AWS EC2 from a local CLI — pick a model, spin up a right-sized GPU instance, and get a local OpenAI-compatible endpoint over AWS SSM.",
    "keywords": [
        "llm",
        "aws",
        "ec2",
        "vllm",
        "terraform",
        "openai",
        "cli",
        "huggingface",
        "gpu"
    ],
    "license": "Apache-2.0",
    "author": "Tomasz Czechowski <tomasz@czechowski.pl>",
    "repository": {
        "url": "https://github.com/tomaszczechowski/llmrun",
        "type": "github"
    },
    "type": "module",
    "bin": {
        "llmrun": "dist/cli.js"
    },
    "files": [
        "dist",
        "terraform",
        "templates",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@9.12.0",
    "scripts": {
        "dev": "tsx src/cli.ts",
        "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepublishOnly": "pnpm run build",
        "docs:dev": "pnpm --filter llmrun-docs dev",
        "docs:build": "pnpm --filter llmrun-docs build",
        "docs:preview": "pnpm --filter llmrun-docs start"
    },
    "dependencies": {
        "@aws-sdk/client-ec2": "^3.1094.0",
        "@aws-sdk/client-pricing": "^3.1094.0",
        "@aws-sdk/client-service-quotas": "^3.1094.0",
        "@aws-sdk/client-ssm": "^3.1094.0",
        "@aws-sdk/credential-providers": "^3.1094.0",
        "@inquirer/prompts": "^7.10.1",
        "commander": "^12.1.0",
        "execa": "^9.6.1",
        "ora": "^8.2.0",
        "picocolors": "^1.1.1",
        "yaml": "^2.9.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3"
    }
}
